{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/duckdb-forensics/wal-report.schema.json",
  "title": "duckdb-forensics WAL report",
  "description": "Offline frame analysis for an unencrypted DuckDB v2 WAL. last_good_flush is not an acknowledged commit or a safe recovery point.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "status", "input", "version", "encrypted", "version_header", "entries", "summary", "first_unparsed_offset", "first_checksum_mismatch_offset", "scan_stop_offset", "tail", "confirmed_flushes", "last_good_flush", "unterminated_data_after_last_flush", "checkpoint_marker", "coverage", "findings", "inferences", "unknowns"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "status": { "enum": ["complete", "incomplete", "empty", "unsupported", "invalid", "resource_limit_reached"] },
    "input": { "$ref": "report-common.schema.json#/$defs/input" },
    "version": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
    "encrypted": { "type": ["boolean", "null"] },
    "version_header": { "anyOf": [{ "$ref": "#/$defs/versionHeader" }, { "type": "null" }] },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "summary": { "$ref": "#/$defs/summary" },
    "first_unparsed_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
    "first_checksum_mismatch_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
    "scan_stop_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
    "tail": { "$ref": "#/$defs/tail" },
    "confirmed_flushes": { "type": "array", "items": { "$ref": "#/$defs/flush" } },
    "confirmed_flushes_omitted": { "$ref": "report-common.schema.json#/$defs/offset" },
    "last_good_flush": { "anyOf": [{ "$ref": "#/$defs/flush" }, { "type": "null" }] },
    "unterminated_data_after_last_flush": { "type": "boolean" },
    "checkpoint_marker": { "anyOf": [{ "$ref": "#/$defs/checkpoint" }, { "type": "null" }] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "findings": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/finding" } },
    "findings_omitted": { "$ref": "report-common.schema.json#/$defs/offset" },
    "inferences": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/inference" } },
    "unknowns": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/unknown" } },
    "unknowns_omitted": { "$ref": "report-common.schema.json#/$defs/offset" },
    "report_limits": { "type": "array", "items": { "enum": ["entries", "confirmed_flushes", "findings", "unknowns"] }, "uniqueItems": true }
  },
  "$defs": {
    "versionHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "checkpoint_iteration"],
      "properties": {
        "offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "length": { "$ref": "report-common.schema.json#/$defs/offset" },
        "checkpoint_iteration": { "$ref": "report-common.schema.json#/$defs/optionalOffset" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "offset", "payload_offset", "declared_length", "actual_length", "actual_frame_length", "declared_frame_end", "actual_frame_end", "stored_checksum", "computed_checksum", "checksum_status", "entry_type", "raw_entry_type", "entry_type_reason", "payload_status", "parse_status"],
      "properties": {
        "index": { "$ref": "report-common.schema.json#/$defs/offset" },
        "offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "payload_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "declared_length": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "actual_length": { "$ref": "report-common.schema.json#/$defs/offset" },
        "actual_frame_length": { "$ref": "report-common.schema.json#/$defs/offset" },
        "declared_frame_end": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "actual_frame_end": { "$ref": "report-common.schema.json#/$defs/offset" },
        "stored_checksum": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{16}$" },
        "computed_checksum": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{16}$" },
        "checksum_status": { "enum": ["valid", "mismatch", "unavailable"] },
        "entry_type": { "type": "string" },
        "raw_entry_type": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "entry_type_reason": { "type": ["string", "null"] },
        "payload_status": { "enum": ["not_decoded", "empty_flush", "checkpoint_decoded", "invalid", "unavailable"] },
        "parse_status": { "enum": ["complete", "checksum_mismatch", "invalid_entry_length", "entry_exceeds_remaining_file", "truncated_entry", "resource_limit_reached"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_entries", "successfully_parsed_entries", "checksum_failed_entries", "out_of_bounds_entries", "truncated_entries", "unknown_type_entries"],
      "properties": {
        "total_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "reported_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "entries_omitted": { "$ref": "report-common.schema.json#/$defs/offset" },
        "successfully_parsed_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "checksum_failed_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "out_of_bounds_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "truncated_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "unknown_type_entries": { "$ref": "report-common.schema.json#/$defs/offset" },
        "not_decoded_entries": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "flush": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_index", "entry_offset", "end_offset"],
      "properties": {
        "entry_index": { "$ref": "report-common.schema.json#/$defs/offset" },
        "entry_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "end_offset": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_index", "entry_offset", "block_pointer", "offset_within_block"],
      "properties": {
        "entry_index": { "$ref": "report-common.schema.json#/$defs/offset" },
        "entry_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "block_pointer": { "$ref": "report-common.schema.json#/$defs/offset" },
        "offset_within_block": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "tail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "all_zero", "zero_suffix_offset", "zero_suffix_length"],
      "properties": {
        "offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "length": { "$ref": "report-common.schema.json#/$defs/offset" },
        "all_zero": { "type": ["boolean", "null"] },
        "zero_suffix_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "zero_suffix_length": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_size", "scanned_bytes", "scanned_percent", "complete_frame_bytes", "complete_frame_percent", "payload_decoding"],
      "properties": {
        "file_size": { "$ref": "report-common.schema.json#/$defs/offset" },
        "scanned_bytes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "scanned_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "complete_frame_bytes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "complete_frame_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "payload_decoding": { "const": "wal_type_envelope_flush_and_checkpoint_only" }
      }
    }
  }
}
