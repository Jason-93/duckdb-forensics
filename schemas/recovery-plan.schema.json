{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/duckdb-forensics/recovery-plan.schema.json",
  "title": "duckdb-forensics advisory recovery plan",
  "description": "Observations and candidate advice only; no action is executed and no lossless recovery is claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "status", "evidence_dir", "observed_facts", "findings", "inferences", "unknowns", "candidate_actions", "risks"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "status": { "enum": ["complete", "incomplete"] },
    "evidence_dir": { "type": "string" },
    "observed_facts": { "$ref": "#/$defs/observedFacts" },
    "findings": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/finding" } },
    "inferences": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/inference" } },
    "unknowns": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/unknown" } },
    "candidate_actions": { "type": "array", "items": { "$ref": "#/$defs/candidateAction" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_size", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "path_encoding": { "$ref": "report-common.schema.json#/$defs/pathEncoding" },
        "file_size": { "$ref": "report-common.schema.json#/$defs/offset" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observedFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "evidence_unchanged", "database", "wal", "oracle"],
      "properties": {
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "inventory_complete": { "type": "boolean" },
        "evidence_unchanged": { "type": "boolean" },
        "database": { "anyOf": [{ "$ref": "verify-report.schema.json" }, { "type": "null" }] },
        "wal": { "anyOf": [{ "$ref": "wal-report.schema.json" }, { "type": "null" }] },
        "oracle": { "anyOf": [{ "$ref": "report-common.schema.json#/$defs/oracle" }, { "type": "null" }] }
      }
    },
    "possibleDataLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_offset", "end_offset", "byte_length", "description"],
      "properties": {
        "start_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "end_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "byte_length": { "$ref": "report-common.schema.json#/$defs/offset" },
        "description": { "type": "string" }
      }
    },
    "candidateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_wal", "target_offset", "evidence", "possible_data_loss", "must_execute_on_copy", "must_reverify_result", "manual_steps"],
      "properties": {
        "action": { "const": "candidate_wal_truncation" },
        "target_wal": { "type": "string" },
        "target_offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "report-common.schema.json#/$defs/evidence" } },
        "possible_data_loss": { "$ref": "#/$defs/possibleDataLoss" },
        "must_execute_on_copy": { "const": true },
        "must_reverify_result": { "const": true },
        "manual_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
