{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/duckdb-forensics/verify-report.schema.json",
  "title": "duckdb-forensics main-file verification report",
  "description": "Read-only checksum, geometry, and metadata-chain verification; not a database-health verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "status", "input", "observations", "selected_header", "blocks", "meta_chains", "trailing_data", "coverage", "findings", "inferences", "checks_passed", "checks_failed", "checks_skipped", "unknowns", "oracle"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "status": { "enum": ["complete", "incomplete", "unsupported", "resource_limit_reached"] },
    "input": { "$ref": "report-common.schema.json#/$defs/input" },
    "observations": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/observation" } },
    "selected_header": { "anyOf": [{ "$ref": "#/$defs/selectedHeader" }, { "type": "null" }] },
    "blocks": { "$ref": "#/$defs/blocks" },
    "meta_chains": { "type": "array", "items": { "$ref": "#/$defs/metaChain" } },
    "trailing_data": { "$ref": "#/$defs/trailing" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "findings": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/finding" } },
    "inferences": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/inference" } },
    "checks_passed": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/check" } },
    "checks_failed": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/check" } },
    "checks_skipped": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/skippedCheck" } },
    "unknowns": { "type": "array", "items": { "$ref": "report-common.schema.json#/$defs/unknown" } },
    "oracle": { "anyOf": [{ "$ref": "report-common.schema.json#/$defs/oracle" }, { "type": "null" }] }
  },
  "$defs": {
    "selectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "iteration", "block_count", "block_alloc_size", "meta_block", "free_list"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "iteration": { "$ref": "report-common.schema.json#/$defs/offset" },
        "block_count": { "$ref": "report-common.schema.json#/$defs/offset" },
        "block_alloc_size": { "$ref": "report-common.schema.json#/$defs/offset" },
        "meta_block": { "$ref": "report-common.schema.json#/$defs/offset" },
        "free_list": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block_id", "offset", "expected_length", "actual_length", "message"],
      "properties": {
        "kind": { "enum": ["checksum_mismatch", "truncated_block", "out_of_bounds", "trailing_data"] },
        "block_id": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "offset": { "$ref": "report-common.schema.json#/$defs/offset" },
        "expected_length": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "actual_length": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "message": { "type": "string" }
      }
    },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_scan_requested", "physical_blocks_scanned", "metadata_blocks_checked", "valid_checksums", "checksum_mismatches", "truncated_blocks", "out_of_bounds_references", "complete_blocks_beyond_header_count", "trailing_bytes", "issues", "issues_omitted"],
      "properties": {
        "full_scan_requested": { "type": "boolean" },
        "physical_blocks_scanned": { "$ref": "report-common.schema.json#/$defs/offset" },
        "metadata_blocks_checked": { "$ref": "report-common.schema.json#/$defs/offset" },
        "valid_checksums": { "$ref": "report-common.schema.json#/$defs/offset" },
        "checksum_mismatches": { "$ref": "report-common.schema.json#/$defs/offset" },
        "truncated_blocks": { "$ref": "report-common.schema.json#/$defs/offset" },
        "out_of_bounds_references": { "$ref": "report-common.schema.json#/$defs/offset" },
        "complete_blocks_beyond_header_count": { "$ref": "report-common.schema.json#/$defs/offset" },
        "trailing_bytes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "issues_omitted": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "metaChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root_pointer", "status", "visited_nodes", "verified_nodes", "payload_capacity", "stop_offset", "cycle_pointer"],
      "properties": {
        "name": { "enum": ["meta_block", "free_list"] },
        "root_pointer": { "$ref": "report-common.schema.json#/$defs/offset" },
        "status": { "enum": ["terminated", "not_present", "cycle", "invalid_pointer", "checksum_unavailable", "unsupported", "resource_limit_reached"] },
        "visited_nodes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "verified_nodes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "payload_capacity": { "$ref": "report-common.schema.json#/$defs/offset" },
        "stop_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "cycle_pointer": { "$ref": "report-common.schema.json#/$defs/optionalOffset" }
      }
    },
    "trailing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_file_end", "complete_blocks_beyond_header_count", "residual_offset", "residual_bytes"],
      "properties": {
        "recorded_file_end": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "complete_blocks_beyond_header_count": { "$ref": "report-common.schema.json#/$defs/offset" },
        "residual_offset": { "$ref": "report-common.schema.json#/$defs/optionalOffset" },
        "residual_bytes": { "$ref": "report-common.schema.json#/$defs/offset" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_size", "integrity_checked_bytes", "integrity_checked_percent", "meta_checked_bytes", "checked", "not_checked", "unsupported", "unavailable"],
      "properties": {
        "file_size": { "$ref": "report-common.schema.json#/$defs/offset" },
        "integrity_checked_bytes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "integrity_checked_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "meta_checked_bytes": { "$ref": "report-common.schema.json#/$defs/offset" },
        "checked": { "type": "array", "items": { "type": "string" } },
        "not_checked": { "type": "array", "items": { "type": "string" } },
        "unsupported": { "type": "array", "items": { "type": "string" } },
        "unavailable": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
